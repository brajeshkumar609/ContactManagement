# Copy to .env and set values
PORT=5000
# Use this when running docker-compose in repository root: mongodb://mongo:27017/contacts
# Or set your MongoAtlas/remote URI
MONGODB_URI=mongodb://localhost:27017/contacts

# Set to the frontend origin in production to restrict CORS (e.g., https://example.com)
# CORS_ORIGIN=

# Set NODE_ENV=production in production environments
# NODE_ENV=development
